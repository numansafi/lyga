# PostHog (Validation Funnel)
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://eu.i.posthog.com

# Supabase (Optional during local dev; falls back to .lyga-dev-data/)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Cloudflare R2 (Optional during local dev; falls back to .lyga-dev-data/blobs/)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=

# Session signing secret (Optional in local dev; required in production)
LYGA_SESSION_SECRET=

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
